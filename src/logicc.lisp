(in-package :cl-user)
(define-condition logicc-error (error)
  ((message :initarg :message :reader logicc-error-message))
  (:report (lambda (condition stream)
             (format stream "LogicC Error: ~A" (logicc-error-message condition)))))
(define-condition logicc-syntax-error (logicc-error) ())
(define-condition logicc-runtime-error (logicc-error) ())
(defparameter *allowed-attributes* (make-hash-table :test 'equal))
(defun init-whitelist ()
  (clrhash *allowed-attributes*)
  (setf (gethash "out"   *allowed-attributes*) '(:TARGET :RAW :SPEC :MODE))
  (setf (gethash "read"  *allowed-attributes*) '(:SOURCE :OFFSET :TYPE :UNTIL :ELSE_ERROR))
  (setf (gethash "write" *allowed-attributes*) '(:TARGET :OFFSET :TYPE :ELSE_ERROR))
  (setf (gethash "alloc" *allowed-attributes*) '(:SIZE :HEAP :ELSE_ERROR))
  (setf (gethash "free"  *allowed-attributes*) '(:HEAP))
  (setf (gethash "fill"  *allowed-attributes*) '(:VALUE :BYTES))
  (setf (gethash "check" *allowed-attributes*) '(:JUMP))
  (setf (gethash "wait"  *allowed-attributes*) '(:MS :TARGET :STATUS))
  (setf (gethash "jump"  *allowed-attributes*) '())
  (setf (gethash "repeat"*allowed-attributes*) '(:COUNT :WHILE))
  (setf (gethash "exit"  *allowed-attributes*) '(:CODE))
  (setf (gethash "call"  *allowed-attributes*) '(:IN :OUT))
  (setf (gethash "return"*allowed-attributes*) '())
  (setf (gethash "fn"    *allowed-attributes*) '(:IN :OUT :MACRO)))
(init-whitelist)
(defstruct instruction
  line-num
  file      
  rel-line
  type
  name
  action
  target
  attributes
  punct
  (indent 0)) 
(defun count-indent (line)
  "Рахує кількість пробілів на початку рядка (1 Таб = 4 пробіли)."
  (let ((count 0))
    (loop for ch across line do
      (cond
        ((char= ch #\Space) (incf count))
        ((char= ch #\Tab) (incf count 4))
        (t (return count))))
    count))
(defstruct vm-state
  (variables    (make-hash-table :test 'equal))
  (memory       (make-array 16777216 :element-type '(unsigned-byte 8) :initial-element 0))
  (heap-ptr     1024)
  (labels       (make-hash-table :test 'equal))
  (functions    (make-hash-table :test 'equal))
  (call-stack   '())
  (instructions (make-array 0 :fill-pointer 0 :adjustable t))
  (pc           0)
  (halted       nil)
  (exit-code    0))
(defun validate-attributes (action attributes line-num)
  (declare (ignore line-num))
  (let ((action-key (string-downcase action)))
    (multiple-value-bind (allowed exists) (gethash action-key *allowed-attributes*)
      (when exists
        (dolist (attr attributes)
          (let ((attr-key (car attr)))
            (unless (or (member attr-key allowed)
                        (char= (char (symbol-name attr-key) 0) #\X))
              (format t "[WARNING] Unknown attribute '-~A' for '~A'~%" 
                      (string-downcase (symbol-name attr-key)) action))))))))
(defun whitespace-char-p (ch)
  (member ch '(#\Space #\Tab #\Newline #\Return)))
(defun trim-string (str)
  (string-trim '(#\Space #\Tab #\Newline #\Return #\Nul) str))
(defun strip-comment (line)
  (let ((pos (search "//" line)))
    (if pos (subseq line 0 pos) line)))
(defun tokenize-line (line line-num &optional (file "main"))
  (let ((tokens '())
        (len (length line))
        (i 0))
    (loop while (< i len) do
      (let ((ch (char line i)))
        (cond
          ((whitespace-char-p ch)
           (incf i))
          ((char= ch #\")
           (let ((start (1+ i))
                 (end (position #\" line :start (1+ i))))
             (unless end
               (error 'logicc-syntax-error
                      :message (format nil "[~A:~A] Unterminated string literal" file line-num)))
             (push (cons :string-literal (subseq line start end)) tokens)
             (setf i (1+ end))))
          (t
           (let ((start i))
             (loop while (and (< i len)
                              (not (whitespace-char-p (char line i))))
                   do (incf i))
             (push (subseq line start i) tokens))))))
    (nreverse tokens)))
(defun parse-attribute-token (token)
  (if (and (consp token) (eq (car token) :string-literal))
      nil
      (when (and (stringp token) (> (length token) 1) (char= (char token 0) #\-))
        (let ((colon-pos (position #\: token :start 1)))
          (if colon-pos
              (let ((key-str (subseq token 1 colon-pos))
                    (val-str (subseq token (1+ colon-pos))))
                (cons (intern (string-upcase key-str) :keyword) val-str))
              (let ((key-str (subseq token 1)))
                (cons (intern (string-upcase key-str) :keyword) t)))))))
(defun parse-line (raw-line line-num &optional (file "main") (rel-line line-num))
  (let ((clean-line (trim-string (strip-comment raw-line))))
    (when (string= clean-line "")
      (return-from parse-line nil))
    (let ((last-char (char clean-line (1- (length clean-line)))))
      (unless (member last-char '(#\. #\:))
        (error 'logicc-syntax-error
               :message (format nil "[~A:~A] Missing parser punctuation ('.' or ':')" file rel-line)))
      (let* ((punct (string last-char))
             (content (trim-string (subseq clean-line 0 (1- (length clean-line)))))
             (raw-tokens (tokenize-line content rel-line file)))
        (unless raw-tokens
          (return-from parse-line nil))
        (cond
          ((and (>= (length raw-tokens) 2)
                (stringp (nth 0 raw-tokens))
                (string-equal (nth 0 raw-tokens) "fn")
                (string= punct ":"))
           (let* ((fn-name (if (consp (nth 1 raw-tokens)) (cdr (nth 1 raw-tokens)) (nth 1 raw-tokens)))
                  (rest-toks (nthcdr 2 raw-tokens))
                  (attrs '()))
             (dolist (tok rest-toks)
               (let ((parsed-attr (parse-attribute-token tok)))
                 (when parsed-attr
                   (push parsed-attr attrs))))
             (make-instruction :line-num line-num 
                               :file file
                               :rel-line rel-line
                               :type :fn 
                               :name fn-name 
                               :attributes (nreverse attrs) 
                               :punct punct)))
          ((and (= (length raw-tokens) 1)
                (stringp (car raw-tokens))
                (string-equal (car raw-tokens) "else")
                (string= punct ":"))
           (make-instruction :line-num line-num :file file :rel-line rel-line :type :else :name "else" :punct punct))
          ((and (= (length raw-tokens) 1) (string= punct ":"))
           (let ((name (if (consp (car raw-tokens)) (cdr (car raw-tokens)) (car raw-tokens))))
             (if (string-equal name "entry")
                 (make-instruction :line-num line-num :file file :rel-line rel-line :type :entry :name "entry" :punct punct)
                 (make-instruction :line-num line-num :file file :rel-line rel-line :type :label :name name :punct punct))))
          ((and (>= (length raw-tokens) 3) 
                (stringp (nth 1 raw-tokens)) 
                (string= (nth 1 raw-tokens) "="))
           (let ((var-name (if (consp (nth 0 raw-tokens)) (cdr (nth 0 raw-tokens)) (nth 0 raw-tokens)))
                 (rhs-tokens (nthcdr 2 raw-tokens)))
             (let* ((first-tok (car rhs-tokens))
                    (first-str (if (consp first-tok) (cdr first-tok) first-tok)))
               (if (and (not (char= (char first-str 0) #\())
                        (gethash (string-downcase first-str) *allowed-attributes*))
                   (let ((action first-str)
                         (rest-tokens (cdr rhs-tokens))
                         (target nil)
                         (attrs '()))
                     (dolist (tok rest-tokens)
                       (let ((parsed-attr (parse-attribute-token tok)))
                         (if parsed-attr
                             (push parsed-attr attrs)
                             (let ((val (if (consp tok) (format nil "\"~A\"" (cdr tok)) tok)))
                               (setf target (if (null target) val (format nil "~A ~A" target val)))))))
                     (setf attrs (nreverse attrs))
                     (validate-attributes action attrs line-num)
                     (make-instruction :line-num line-num
                                       :file file
                                       :rel-line rel-line
                                       :type :assignment
                                       :name var-name
                                       :action action
                                       :target target
                                       :attributes attrs
                                       :punct punct))
                   (let ((expr-str (format nil "~{~A~^ ~}" 
                                           (mapcar (lambda (tk) (if (consp tk) (cdr tk) tk)) rhs-tokens))))
                     (make-instruction :line-num line-num
                                       :file file
                                       :rel-line rel-line
                                       :type :assignment
                                       :name var-name
                                       :target expr-str
                                       :punct punct))))))
          ((>= (length raw-tokens) 1)
           (let* ((first-tok (car raw-tokens))
                  (action (if (consp first-tok) (cdr first-tok) first-tok))
                  (rest-tokens (cdr raw-tokens))
                  (target nil)
                  (attrs '()))
             (dolist (tok rest-tokens)
               (let ((parsed-attr (parse-attribute-token tok)))
                 (if parsed-attr
                     (push parsed-attr attrs)
                     (let ((val (if (consp tok) (format nil "\"~A\"" (cdr tok)) tok)))
                       (setf target (if (null target) val (format nil "~A ~A" target val)))))))
             (setf attrs (nreverse attrs))
             (validate-attributes action attrs line-num)
             (make-instruction :line-num line-num
                               :file file
                               :rel-line rel-line
                               :type :command
                               :action action
                               :target target
                               :attributes attrs
                               :punct punct)))
          (t
           (error 'logicc-syntax-error
                  :message (format nil "[~A:~A] Invalid statement format" file rel-line))))))))
(defun parse-program (code-string &optional (file "main"))
  (let ((instructions (make-array 0 :fill-pointer 0 :adjustable t))
        (line-num 0))
    (with-input-from-string (stream code-string)
      (loop for line = (read-line stream nil nil)
            while line do
              (incf line-num)
              (let ((clean-line (trim-string (strip-comment line))))
                (when (string/= clean-line "")
                  (let ((indent (count-indent line))
                        (instr (parse-line line line-num file line-num)))
                    (when instr
                      (setf (instruction-indent instr) indent)
                      (vector-push-extend instr instructions)))))))
    instructions))
(defun parse-and-preprocess (filename &optional (base-path "./"))
  "Рекурсивно зчитує, парсить та об'єднує інструкції з відстеженням файлів."
  (let ((result-instructions (make-array 0 :fill-pointer 0 :adjustable t))
        (rel-line 0))
    (with-open-file (stream filename :direction :input :external-format :utf-8)
      (loop for line = (read-line stream nil nil)
            while line do
              (incf rel-line)
              (let ((trimmed (trim-string (strip-comment line))))
                (cond
                  ((and (>= (length trimmed) 8)
                        (string-equal (subseq trimmed 0 7) "include"))
                   (let* ((tokens (tokenize-line trimmed rel-line))
                          (file-param (nth 1 tokens))
                          (inc-filename (if (consp file-param) (cdr file-param) file-param))
                          (full-path (merge-pathnames inc-filename base-path)))
                     (if (probe-file full-path)
                         (let ((sub-instructions (parse-and-preprocess full-path (directory-namestring full-path))))
                           (loop for instr across sub-instructions do
                             (vector-push-extend instr result-instructions)))
                         (error 'logicc-runtime-error 
                                :message (format nil "Include file not found: ~A" full-path)))))
                  (t
                   (let ((instr (parse-line line rel-line (file-namestring filename) rel-line)))
                     (when instr
                       (setf (instruction-indent instr) (count-indent line))
                       (vector-push-extend instr result-instructions))))))))
    result-instructions))
(defun parse-int-or-hex (str)
  (cond
    ((null str) nil)
    ((integerp str) str)
    ((and (stringp str) (>= (length str) 2) (string-equal (subseq str 0 2) "0x"))
     (parse-integer str :start 2 :radix 16 :junk-allowed t))
    ((stringp str)
     (parse-integer str :junk-allowed t))
    (t nil)))
(defun eval-operand (val vm)
  (cond
    ((null val) nil)
    ((integerp val) val)
    ((consp val) (cdr val)) 
    ((stringp val)
     (let ((trimmed (trim-string val)))
       (if (and (>= (length trimmed) 2)
                (char= (char trimmed 0) #\")
                (char= (char trimmed (1- (length trimmed))) #\"))
           (subseq trimmed 1 (1- (length trimmed)))
           (multiple-value-bind (var-val exists) (gethash trimmed (vm-state-variables vm))
             (if exists
                 var-val
                 (or (parse-int-or-hex trimmed) trimmed))))))
    (t val)))
(defun get-op-precedence (op)
  (cond
    ((member op '("*" "/" "%") :test #'string=) 4)
    ((member op '("+" "-") :test #'string=) 3)
    ((member op '("<<" ">>") :test #'string=) 2)
    ((member op '("&" "^" "|") :test #'string=) 1)
    (t 0)))
(defun apply-op (op v1 v2)
  (let ((n1 (if (numberp v1) v1 0))
        (n2 (if (numberp v2) v2 0)))
    (cond
      ((string= op "+") (+ n1 n2))
      ((string= op "-") (- n1 n2))
      ((string= op "*") (* n1 n2))
      ((string= op "/") (if (zerop n2) 0 (floor n1 n2)))
      ((string= op "%") (if (zerop n2) 0 (mod n1 n2)))
      ((string= op "&") (logand n1 n2))
      ((string= op "|") (logior n1 n2))
      ((string= op "^") (logxor n1 n2))
      ((string= op "<<") (ash n1 n2))
      ((string= op ">>") (ash n1 (- n2)))
      (t n2))))
(defun eval-expression (expr-str vm)
  "Infix math & bitwise expression evaluator with operator precedence."
  (if (null expr-str)
      nil
      (let ((raw-tokens (tokenize-line expr-str 0)))
        (if (null raw-tokens)
            nil
            (let ((val-stack '())
                  (op-stack '()))
              (labels ((process-op ()
                (if (>= (length val-stack) 2)
                    (let ((v2 (pop val-stack))
                          (v1 (pop val-stack))
                          (op (pop op-stack)))
                      (push (apply-op op v1 v2) val-stack))
                    (error 'logicc-syntax-error :message "Malformed arithmetic expression"))))
                (dolist (tok raw-tokens)
                  (let ((str (if (consp tok) (cdr tok) tok)))
                    (if (> (get-op-precedence str) 0)
                        (progn
                          (loop while (and op-stack
                                           (>= (get-op-precedence (car op-stack))
                                               (get-op-precedence str)))
                                do (process-op))
                          (push str op-stack))
                        (push (eval-operand str vm) val-stack))))
                (loop while op-stack do (process-op))
                (car val-stack)))))))
(defun eval-condition (cond-str vm)
  "Evaluates binary condition (==, !=, >, <, >=, <=)."
  (if (null cond-str)
      nil
      (let ((tokens (tokenize-line cond-str 0)))
        (if (= (length tokens) 3)
            (let* ((tok1   (nth 0 tokens))
                   (op-tok (nth 1 tokens))
                   (tok2   (nth 2 tokens))
                   (op     (if (consp op-tok) (cdr op-tok) op-tok))
                   (val1   (if (consp tok1) (cdr tok1) (eval-expression (if (stringp tok1) tok1 "") vm)))
                   (val2   (if (consp tok2) (cdr tok2) (eval-expression (if (stringp tok2) tok2 "") vm))))
              (cond
                ((string= op "==") (equal val1 val2))
                ((string= op "!=") (not (equal val1 val2)))
                ((string= op ">")  (and (numberp val1) (numberp val2) (> val1 val2)))
                ((string= op "<")  (and (numberp val1) (numberp val2) (< val1 val2)))
                ((string= op ">=") (and (numberp val1) (numberp val2) (>= val1 val2)))
                ((string= op "<=") (and (numberp val1) (numberp val2) (<= val1 val2)))
                (t nil)))
            (let ((res (eval-expression cond-str vm)))
              (and res (numberp res) (> res 0)))))))
(defun find-block-end (instructions start-pc)
  "Знаходить PC першої інструкції за межами поточного блоку check/else."
  (let* ((base-indent (instruction-indent (aref instructions start-pc)))
         (len (length instructions))
         (i (1+ start-pc)))
    (loop while (< i len) do
      (let* ((instr (aref instructions i))
             (curr-indent (instruction-indent instr))
             (type (instruction-type instr)))
        (if (< curr-indent base-indent)
            (return i)
            (if (and (= curr-indent base-indent) (not (eq type :ELSE)))
                (return i)
                (incf i)))))
    i))
(defun get-attr (key attrs)
  (cdr (assoc key attrs)))
(defun call-function-sync (fn-name vm &optional attrs)
  (multiple-value-bind (fn-pc exists) (gethash fn-name (vm-state-functions vm))
    (unless exists
      (error 'logicc-runtime-error :message (format nil "Unknown function '~A'" fn-name)))
    (let* ((fn-instr (aref (vm-state-instructions vm) fn-pc))
           (fn-attrs (instruction-attributes fn-instr))
           (formal-in-params (mapcar #'cdr (remove-if-not (lambda (a) (eq (car a) :IN)) fn-attrs)))
           (actual-in-args (mapcar #'cdr (remove-if-not (lambda (a) (eq (car a) :IN)) attrs))))
      (if formal-in-params
          (loop for param in formal-in-params
                for arg in actual-in-args
                do (when (and param arg)
                     (setf (gethash param (vm-state-variables vm))
                           (eval-expression arg vm))))
          (dolist (attr attrs)
            (when (eq (car attr) :IN)
              (let* ((val-str (cdr attr))
                     (evaluated-val (eval-expression val-str vm)))
                (setf (gethash val-str (vm-state-variables vm)) evaluated-val))))))
    (let ((initial-depth (length (vm-state-call-stack vm))))
      (push (vm-state-pc vm) (vm-state-call-stack vm))
      (setf (vm-state-pc vm) fn-pc)
      (loop while (and (> (length (vm-state-call-stack vm)) initial-depth)
                       (not (vm-state-halted vm))
                       (< (vm-state-pc vm) (length (vm-state-instructions vm)))) do
        (step-vm vm)))))
(defun execute-action (action target attrs vm)
  (let ((act (string-downcase action)))
    (cond
      ((string= act "alloc")
       (let* ((size-str   (get-attr :SIZE attrs))
              (err-label  (get-attr :ELSE_ERROR attrs))
              (size       (eval-expression size-str vm)))
         (unless (integerp size)
           (error 'logicc-runtime-error :message "alloc action requires integer -size parameter."))
         (if (> (+ (vm-state-heap-ptr vm) size) 16777216)
             (if err-label
                 (progn
                   (execute-action "jump" err-label '() vm)
                   0)
                 (error 'logicc-runtime-error :message "Out of memory: Heap allocation exceeds 16MB RAM limit."))
             (let ((addr (vm-state-heap-ptr vm)))
               (incf (vm-state-heap-ptr vm) size)
               addr))))
      ((string= act "free") nil)
      ((string= act "wait")
       (let* ((ms-str (get-attr :MS attrs))
              (ms (if ms-str (eval-expression ms-str vm) 0)))
         (when (and (numberp ms) (> ms 0))
           (sleep (/ ms 1000.0)))
         nil))
      ((string= act "fill")
       (let* ((base-addr (eval-expression target vm))
              (val-str   (get-attr :VALUE attrs))
              (bytes-str (get-attr :BYTES attrs))
              (val       (or (eval-expression val-str vm) 0))
              (bytes     (or (eval-expression bytes-str vm) 0)))
         (dotimes (i bytes)
           (setf (aref (vm-state-memory vm) (+ base-addr i)) (logand val #xFF)))
         nil))
      ((string= act "write")
       (let* ((val        (eval-expression target vm))
                (target-str (get-attr :TARGET attrs))
                (offset-str (get-attr :OFFSET attrs))
                (err-label  (get-attr :ELSE_ERROR attrs))
                (base-addr  (eval-expression target-str vm))
                (offset     (if offset-str (eval-expression offset-str vm) 0)) 
                (addr       (+ base-addr offset)))
         (if (or (< addr 0) (> (+ addr 3) (1- (length (vm-state-memory vm)))))
             (if err-label
                 (execute-action "jump" err-label '() vm)
                 (error 'logicc-runtime-error 
                        :message (format nil "RAM Write Out of Bounds: address ~A out of range 0..~A" 
                                              addr (1- (length (vm-state-memory vm))))))
             (progn
               (setf (aref (vm-state-memory vm) addr)       (logand val #xFF))
               (setf (aref (vm-state-memory vm) (+ addr 1)) (logand (ash val -8) #xFF))
               (setf (aref (vm-state-memory vm) (+ addr 2)) (logand (ash val -16) #xFF))
               (setf (aref (vm-state-memory vm) (+ addr 3)) (logand (ash val -24) #xFF))))
         nil))
      ((string= act "read")
       (let* ((raw-source (get-attr :SOURCE attrs))
              (source-str (if (and (stringp raw-source)
                                   (> (length raw-source) 1)
                                   (char= (char raw-source 0) #\")
                                   (char= (char raw-source (1- (length raw-source))) #\"))
                              (subseq raw-source 1 (1- (length raw-source)))
                              raw-source))
              (bytes-attr (get-attr :BYTES attrs))
              (bytes      (if bytes-attr (eval-expression bytes-attr vm) 0))
              (offset-str (get-attr :OFFSET attrs))
              (err-label  (get-attr :ELSE_ERROR attrs)))
         (cond
           ((and source-str (probe-file source-str))
            (let ((base-addr (eval-expression target vm)))
              (with-open-file (stream source-str :element-type '(unsigned-byte 8))
                (let ((read-len (if (> bytes 0) bytes (file-length stream))))
                  (read-sequence (vm-state-memory vm) stream :start base-addr :end (+ base-addr read-len))))
              nil))
           ((and source-str (not (string-equal source-str "console")) (not (numberp (eval-operand source-str vm))))
            (if err-label
                (execute-action "jump" err-label '() vm)
                (error 'logicc-runtime-error :message (format nil "File not found: ~A" source-str))))
          ((and source-str (string-equal source-str "console"))
            (finish-output)
            (let* ((input (trim-string (or (read-line *standard-input* nil "") "")))
                    (parsed (parse-int-or-hex input)))
              (if parsed parsed input)))
           (t
            (let* ((base-addr  (eval-expression source-str vm))
                   (offset     (if offset-str (eval-expression offset-str vm) 0))
                   (addr       (+ base-addr offset)))
              (logior (aref (vm-state-memory vm) addr)
                      (ash (aref (vm-state-memory vm) (+ addr 1)) 8)
                      (ash (aref (vm-state-memory vm) (+ addr 2)) 16)
                      (ash (aref (vm-state-memory vm) (+ addr 3)) 24)))))))
      ((string= act "out")
      (let* ((raw-flag  (get-attr :raw attrs))
              (spec-flag (get-attr :spec attrs))
              (msg-val   (eval-operand target vm))
              (out-str   (if (and (stringp msg-val) (gethash msg-val (vm-state-variables vm)))
                            (gethash msg-val (vm-state-variables vm))
                            (or msg-val ""))))
        (when (and spec-flag (stringp out-str))
          (let ((res ""))
            (loop for i from 0 below (length out-str) do
              (if (and (char= (char out-str i) #\\) (< (1+ i) (length out-str)))
                  (let ((next-ch (char out-str (1+ i))))
                    (cond
                      ((char= next-ch #\r) (setf res (concatenate 'string res (string #\Return))))
                      ((char= next-ch #\n) (setf res (concatenate 'string res (string #\Newline))))
                      ((char= next-ch #\t) (setf res (concatenate 'string res (string #\Tab))))
                      ((char= next-ch #\e) (setf res (concatenate 'string res (string (code-char 27)))))
                      (t (setf res (concatenate 'string res (string next-ch)))))
                    (incf i))
                  (setf res (concatenate 'string res (string (char out-str i))))))
            (setf out-str res)))
        (if raw-flag
            (format t "~A" out-str)
            (format t "~A~%" out-str))
        (finish-output)
        nil))
      ((string= act "jump")
       (multiple-value-bind (target-pc exists) (gethash target (vm-state-labels vm))
         (if exists
             (setf (vm-state-pc vm) target-pc)
             (error 'logicc-runtime-error :message (format nil "Unknown label '~A'" target))))
       nil)
      ((string= act "check")
       (let ((jump-label (get-attr :JUMP attrs)))
         (if jump-label
             (when (eval-condition target vm)
               (execute-action "jump" jump-label '() vm))
             (unless (eval-condition target vm)
               (let* ((curr-pc (1- (vm-state-pc vm)))
                      (instructions (vm-state-instructions vm))
                      (base-indent (instruction-indent (aref instructions curr-pc)))
                      (len (length instructions))
                      (i (1+ curr-pc))
                      (else-pc nil))
                 (loop while (< i len) do
                   (let* ((instr (aref instructions i))
                          (indent (instruction-indent instr)))
                     (cond
                       ((< indent base-indent) (return))
                       ((and (= indent base-indent) (eq (instruction-type instr) :ELSE))
                        (setf else-pc i)
                        (return))
                       ((and (= indent base-indent) (not (eq (instruction-type instr) :ELSE)))
                        (return))
                       (t (incf i)))))
                 (if else-pc
                     (setf (vm-state-pc vm) (1+ else-pc))
                     (setf (vm-state-pc vm) i))))))
       nil)
      ((string= act "call")
       (call-function-sync target vm attrs)
       nil)
      ((string= act "return")
       (if (vm-state-call-stack vm)
           (setf (vm-state-pc vm) (pop (vm-state-call-stack vm)))
           (error 'logicc-runtime-error :message "return executed outside of function call stack."))
       nil)
      ((string= act "repeat")
       (let ((fn-name target)
             (count-str (get-attr :COUNT attrs))
             (while-str (get-attr :WHILE attrs)))
         (cond
           (count-str
            (let ((count (eval-expression count-str vm)))
              (dotimes (i count)
                (call-function-sync fn-name vm attrs))))
           (while-str
            (loop while (and (eval-condition while-str vm) (not (vm-state-halted vm))) do
              (call-function-sync fn-name vm attrs)))))
       nil)
      ((string= act "exit")
       (let ((code (or (eval-expression (get-attr :CODE attrs) vm) 0)))
         (setf (vm-state-halted vm) t)
         (setf (vm-state-exit-code vm) code)
         nil))
      (t
       (error 'logicc-runtime-error :message (format nil "Unhandled action: ~A" action))))))
(defun step-vm (vm)
  "Executes a single instruction at current Program Counter."
  (let* ((pc (vm-state-pc vm))
         (instr (aref (vm-state-instructions vm) pc)))
    (incf (vm-state-pc vm))
    (handler-bind
        ((logicc-error
           (lambda (c)
             (error 'logicc-runtime-error
                    :message (format nil "[~A:~A] ~A"
                                     (instruction-file instr)
                                     (instruction-rel-line instr)
                                     (logicc-error-message c))))))
      (case (instruction-type instr)
        (:ELSE
         (let ((next-pc (find-block-end (vm-state-instructions vm) pc)))
           (setf (vm-state-pc vm) next-pc)))
        (:ASSIGNMENT
         (let ((res (if (instruction-action instr)
                        (execute-action (instruction-action instr)
                                        (instruction-target instr)
                                        (instruction-attributes instr)
                                        vm)
                        (eval-expression (instruction-target instr) vm))))
           (setf (gethash (instruction-name instr) (vm-state-variables vm)) (or res 0))))
        (:COMMAND
         (execute-action (instruction-action instr)
                         (instruction-target instr)
                         (instruction-attributes instr)
                         vm))))))
(defun run-vm (code-string)
  (let ((instructions (parse-program code-string))
        (vm (make-vm-state)))
    (setf (vm-state-instructions vm) instructions)
    (loop for i from 0 below (length instructions) do
      (let ((instr (aref instructions i)))
        (cond
          ((eq (instruction-type instr) :ENTRY)
           (setf (gethash "entry" (vm-state-labels vm)) i))
          ((eq (instruction-type instr) :LABEL)
           (setf (gethash (instruction-name instr) (vm-state-labels vm)) i))
          ((eq (instruction-type instr) :FN)
           (setf (gethash (instruction-name instr) (vm-state-functions vm)) i)))))
    (multiple-value-bind (entry-pc exists) (gethash "entry" (vm-state-labels vm))
      (setf (vm-state-pc vm) (if exists entry-pc 0)))
    (loop while (and (< (vm-state-pc vm) (length instructions))
                     (not (vm-state-halted vm))) do
      (step-vm vm))
    vm))
(defun read-file-to-string (filename)
  (with-open-file (stream filename :direction :input :external-format :utf-8)
    (with-output-to-string (out)
      (loop for line = (read-line stream nil nil)
            while line do (write-line line out)))))
(defun run-file (filename)
  (handler-case
      (let* ((instructions (parse-and-preprocess filename (directory-namestring filename))))
        (format t "~%[LOGICC] Запуск файлу: ~A~%" filename)
        (format t "-----------------------------------------------------------~%")
        (let ((vm (make-vm-state)))
          (setf (vm-state-instructions vm) instructions)
          (loop for i from 0 below (length instructions) do
            (let ((instr (aref instructions i)))
              (cond
                ((eq (instruction-type instr) :ENTRY)
                 (setf (gethash "entry" (vm-state-labels vm)) i))
                ((eq (instruction-type instr) :LABEL)
                 (setf (gethash (instruction-name instr) (vm-state-labels vm)) i))
                ((eq (instruction-type instr) :FN)
                 (setf (gethash (instruction-name instr) (vm-state-functions vm)) i)))))
          (multiple-value-bind (entry-pc exists) (gethash "entry" (vm-state-labels vm))
            (setf (vm-state-pc vm) (if exists entry-pc 0)))
          (loop while (and (< (vm-state-pc vm) (length instructions))
                           (not (vm-state-halted vm))) do
            (step-vm vm))
          (format t "-----------------------------------------------------------~%")
          (format t "[LOGICC] Програму завершено з кодом: ~A~%~%" (vm-state-exit-code vm))))
    (logicc-error (c)
      (format t "~%[LOGICC ERROR] ~A~%~%" (logicc-error-message c)))
    (file-error ()
      (format t "~%[SYS ERROR] Не вдалося відкрити файл: ~A~%~%" filename))))
(defun main ()
  (let ((args (cdr sb-ext:*posix-argv*)))
    (if args
        (run-file (car args))
        (format t "Usage: logicc <filename.lc>~%"))))
(let ((args (cdr sb-ext:*posix-argv*)))
  (when args
    (run-file (car args))))